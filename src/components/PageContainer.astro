---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<main
  class:list={[
    "min-h-full flex-1 w-full flex justify-center bg-white dark:bg-neutral-950 overflow-y-auto px-4 sm:px-6 md:px-0 transition-colors pb-24 sm:pb-32",
    className,
  ]}
>
  <slot />
</main>
