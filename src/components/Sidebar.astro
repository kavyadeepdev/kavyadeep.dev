---
import {
  GraduationCap,
  MapPin,
  Mail,
  Download,
  Menu,
  X,
} from "@lucide/astro";
import Navbar from "./Navbar.astro";
import ThemeToggle from "./ThemeToggle.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import TwitterIcon from "./icons/TwitterIcon.astro";
---

<!-- Mobile Top Navigation Header -->
<header
  class="md:hidden flex items-center justify-between px-4 py-3 bg-neutral-100 dark:bg-neutral-900 border-b border-gray-200 dark:border-neutral-800 sticky top-0 z-30 flex-shrink-0 w-full"
>
  <div class="flex items-center gap-3">
    <button
      type="button"
      id="sidebar-open-btn"
      aria-label="Open navigation menu"
      class="p-1.5 -ml-1 rounded-lg text-neutral-700 dark:text-neutral-200 hover:bg-neutral-200/60 dark:hover:bg-neutral-800 active:bg-neutral-300/60 transition-colors focus:outline-none cursor-pointer"
    >
      <Menu size={22} />
    </button>
    <div class="flex items-center gap-2.5">
      <div class="h-8 w-8 relative flex-shrink-0">
        <img
          src="/profile.jpg"
          alt="profile picture"
          class="rounded-full object-cover w-8 h-8 ring-1 ring-neutral-200 dark:ring-neutral-700"
        />
      </div>
      <div>
        <h1 class="text-neutral-900 dark:text-white text-sm font-medium leading-tight font-cal">
          Kavyadeep Dev
        </h1>
        <h3 class="font-light text-xs text-neutral-500 dark:text-neutral-400 leading-tight">
          Full-Stack Developer
        </h3>
      </div>
    </div>
  </div>
  <ThemeToggle />
</header>

<!-- Mobile Backdrop Overlay -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 bg-black/40 dark:bg-black/60 z-40 backdrop-blur-xs md:hidden transition-opacity duration-300 hidden"
  aria-hidden="true"
>
</div>

<!-- Sidebar Drawer / Desktop Aside -->
<aside
  id="sidebar-drawer"
  class="fixed top-0 left-0 h-screen w-[17rem] bg-neutral-100 dark:bg-neutral-900 pt-8 px-4 border-r border-gray-200 dark:border-neutral-800 z-50 overflow-y-auto transition-transform duration-300 ease-in-out md:translate-x-0 -translate-x-full"
>
  <!-- Title / Profile Info -->
  <div class="flex items-center justify-between mb-12">
    <div class="flex items-center gap-2">
      <div class="h-10 w-10 relative flex-shrink-0">
        <img
          src="/profile.jpg"
          alt="profile picture"
          class="rounded-full object-cover w-10 h-10 ring-1 ring-neutral-200 dark:ring-neutral-700"
        />
      </div>
      <div>
        <h1 class="text-neutral-900 dark:text-white font-cal">
          Kavyadeep Dev
        </h1>
        <h3 class="font-light text-sm text-neutral-500 dark:text-neutral-400">Full-Stack Developer</h3>
      </div>
    </div>
    <div class="flex items-center gap-1">
      <ThemeToggle class="hidden md:flex" />
      <!-- Close button inside sidebar on mobile -->
      <button
        type="button"
        id="sidebar-close-btn"
        aria-label="Close navigation menu"
        class="md:hidden p-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-200/60 dark:hover:bg-neutral-800 transition cursor-pointer"
      >
        <X size={20} />
      </button>
    </div>
  </div>

  <!-- Location / Bio-data -->
  <div class="flex flex-col gap-2 text-sm mb-12 pl-2">
    <h2 class="text-xs uppercase font-semibold tracking-wide text-neutral-500/80 dark:text-neutral-400/80">
      Bio-data
    </h2>
    <div class="flex gap-2 items-center text-neutral-600 dark:text-neutral-300">
      <GraduationCap size={16} />
      <p>B.M.S. College of Engineering</p>
    </div>
    <div class="flex gap-2 items-center text-neutral-600 dark:text-neutral-300">
      <MapPin size={16} />
      <p>Bengaluru, KA</p>
    </div>
    <div class="flex gap-2 items-center text-neutral-600 dark:text-neutral-300">
      <Mail size={16} />
      <p class="underline decoration-dashed">
        <a href="mailto:kavyadeepdev@proton.me">kavyadeepdev@proton.me</a>
      </p>
    </div>
  </div>

  <!-- Navbar -->
  <Navbar />

  <!-- Links -->
  <div class="flex flex-col gap-2 text-sm mb-12 pl-2">
    <h2 class="text-xs uppercase font-semibold tracking-wide text-neutral-500/80 dark:text-neutral-400/80">
      Links
    </h2>
    <a
      href="https://github.com/kavyadeepdev"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white transition-colors"
    >
      <GithubIcon size={16} />
      GitHub ↗
    </a>
    <a
      href="https://linkedin.com/in/kavyadeepdev/"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white transition-colors"
    >
      <LinkedinIcon size={16} />
      LinkedIn ↗
    </a>
    <a
      href="https://x.com/kavyadeepdev"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white transition-colors"
    >
      <TwitterIcon size={16} />
      Twitter ↗
    </a>
  </div>

  <!-- Resume Download -->
  <div class="pb-8">
    <a
      href="/KavyadeepDev_Resume.pdf"
      download
      class="inline-flex items-center gap-2 bg-blue-500 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-600 dark:hover:bg-blue-400 transition shadow-xs"
    >
      <Download size={16} />
      Download CV
    </a>
  </div>
</aside>

<script>
  function setupSidebar() {
    const openBtn = document.getElementById("sidebar-open-btn");
    const closeBtn = document.getElementById("sidebar-close-btn");
    const backdrop = document.getElementById("sidebar-backdrop");
    const drawer = document.getElementById("sidebar-drawer");

    function openSidebar() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove("-translate-x-full");
      drawer.classList.add("translate-x-0", "shadow-2xl");
      backdrop.classList.remove("hidden");
    }

    function closeSidebar() {
      if (!drawer || !backdrop) return;
      drawer.classList.add("-translate-x-full");
      drawer.classList.remove("translate-x-0", "shadow-2xl");
      backdrop.classList.add("hidden");
    }

    openBtn?.addEventListener("click", openSidebar);
    closeBtn?.addEventListener("click", closeSidebar);
    backdrop?.addEventListener("click", closeSidebar);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeSidebar();
      }
    });
  }

  setupSidebar();
  document.addEventListener("astro:page-load", setupSidebar);
</script>
