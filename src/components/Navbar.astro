---
import { House, Briefcase, Mail } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const pages = [
  {
    title: "Home",
    url: "/",
    icon: House,
  },
  {
    title: "Projects",
    url: "/projects",
    icon: Briefcase,
  },
  {
    title: "Contact",
    url: "/contact",
    icon: Mail,
  },
];
---

<nav class:list={["mb-12 text-sm", className]}>
  <h2
    class="text-xs uppercase font-semibold tracking-wide text-neutral-500/80 dark:text-neutral-400/80 pl-2 mb-2"
  >
    Navigation
  </h2>

  <div class="flex flex-col gap-1">
    {
      pages.map((page) => {
        const isActive =
          page.url === "/"
            ? pathname === "/"
            : pathname === page.url || pathname.startsWith(`${page.url}/`);
        const IconComponent = page.icon;
        return (
          <a
            href={page.url}
            class:list={[
              "flex items-center gap-2 p-2 rounded-lg transition-all duration-200",
              isActive
                ? "bg-white/70 dark:bg-white/10 backdrop-blur-md border border-white/80 dark:border-white/10 text-neutral-900 dark:text-white font-medium shadow-2xs"
                : "border border-transparent text-neutral-600 dark:text-neutral-300 hover:bg-white/40 dark:hover:bg-white/5 hover:text-neutral-900 dark:hover:text-white",
            ]}
          >
            <IconComponent size={16} />
            {page.title}
          </a>
        );
      })
    }
  </div>
</nav>
