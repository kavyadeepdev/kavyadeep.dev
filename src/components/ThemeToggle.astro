---
import { Sun, Moon } from "@lucide/astro";

interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 18 } = Astro.props;
---

<button
  type="button"
  class:list={[
    "theme-toggle p-2 rounded-xl text-neutral-600 dark:text-neutral-300 bg-white/40 dark:bg-white/5 backdrop-blur-md border border-white/50 dark:border-white/10 hover:bg-white/70 dark:hover:bg-white/15 hover:text-neutral-900 dark:hover:text-white hover:scale-105 active:scale-90 transition-all duration-300 ease-out focus:outline-none cursor-pointer flex items-center justify-center shadow-2xs",
    className,
  ]}
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <Sun size={size} class="hidden dark:block transition-transform duration-300" />
  <Moon size={size} class="block dark:hidden transition-transform duration-300" />
</button>

<script>
  function setupThemeToggle() {
    const toggles = document.querySelectorAll(".theme-toggle");

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const x = mouseEvent.clientX ?? toggle.getBoundingClientRect().left + toggle.clientWidth / 2;
        const y = mouseEvent.clientY ?? toggle.getBoundingClientRect().top + toggle.clientHeight / 2;

        const isDark = document.documentElement.classList.contains("dark");
        const willBeDark = !isDark;

        // Fallback for browsers that do not support View Transitions
        if (!document.startViewTransition) {
          document.documentElement.classList.toggle("dark", willBeDark);
          localStorage.setItem("theme", willBeDark ? "dark" : "light");
          return;
        }

        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );

        const transition = document.startViewTransition(() => {
          document.documentElement.classList.toggle("dark", willBeDark);
          localStorage.setItem("theme", willBeDark ? "dark" : "light");
        });

        transition.ready.then(() => {
          const clipPath = [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ];

          document.documentElement.animate(
            {
              clipPath: clipPath,
            },
            {
              duration: 500,
              easing: "cubic-bezier(0.65, 0, 0.35, 1)",
              pseudoElement: "::view-transition-new(root)",
            }
          );
        });
      });
    });
  }

  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
