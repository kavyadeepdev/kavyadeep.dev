---
interface Props {
  title: string;
  description: string;
  thumbnail?: string;
  tags: string[];
  liveUrl?: string;
  githubUrl?: string;
}

const { title, description, thumbnail, tags, liveUrl, githubUrl } = Astro.props;
---

<div
  class="rounded-xl w-full p-4 flex flex-col sm:flex-row gap-4 border border-gray-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 hover:shadow-md dark:hover:border-neutral-700 dark:hover:bg-neutral-900 hover:border-gray-300 transition-all hover:cursor-pointer mb-4"
>
  {
    thumbnail && (
      <img
        src={thumbnail}
        width={250}
        height={150}
        class="rounded-xl shadow-xs object-cover w-full sm:w-[250px] h-44 sm:h-[150px] flex-shrink-0"
        alt={`${title} project image`}
        loading="lazy"
      />
    )
  }
  <div class="flex flex-col justify-between flex-1">
    <div>
      <h2 class="font-cal text-gray-900 dark:text-white text-lg font-semibold">
        {title}
      </h2>
      <p class="text-gray-600 dark:text-neutral-400 mt-1 text-sm leading-relaxed">
        {description}
      </p>
    </div>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="text-xs px-1.5 py-0.5 bg-gray-100 dark:bg-neutral-800 border border-gray-200 dark:border-neutral-700 text-gray-600 dark:text-neutral-300 rounded-md">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex gap-2 justify-end text-xs mt-3 flex-wrap">
      {
        liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-lg border border-blue-500 dark:border-blue-400 text-blue-500 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors"
          >
            Live ↗
          </a>
        )
      }
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-lg border border-gray-700 dark:border-neutral-600 text-gray-700 dark:text-neutral-300 hover:bg-gray-100 dark:hover:bg-neutral-800 transition-colors"
          >
            Source ↗
          </a>
        )
      }
    </div>
  </div>
</div>
