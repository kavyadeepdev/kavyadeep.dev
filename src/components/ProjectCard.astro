---
interface Props {
  title: string;
  description: string;
  thumbnail?: string;
  tags: string[];
  liveUrl?: string;
  githubUrl?: string;
}

const { title, description, thumbnail, tags, liveUrl, githubUrl } = Astro.props;
---

<div
  class="project-card group relative rounded-2xl w-full p-4.5 border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-xl shadow-xs hover:-translate-y-1 hover:shadow-lg dark:hover:shadow-neutral-950/60 hover:border-neutral-300 dark:hover:border-neutral-700/80 hover:bg-white/90 dark:hover:bg-neutral-900/90 transition-all duration-300 ease-out mb-4 overflow-hidden"
  data-project-card
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-tags={tags.join(",").toLowerCase()}
>
  <!-- Tactile Frosted Particle Texture -->
  <div class="pointer-events-none absolute inset-0 grain-texture opacity-[0.04] dark:opacity-[0.06] mix-blend-overlay z-0" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col sm:flex-row gap-4.5 w-full">
    {
      thumbnail && (
        <div class="overflow-hidden rounded-xl w-full sm:w-[240px] h-44 sm:h-[145px] flex-shrink-0 ring-1 ring-neutral-200/50 dark:ring-neutral-700/50 shadow-xs">
          <img
            src={thumbnail}
            width={240}
            height={145}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
            alt={`${title} project image`}
            loading="lazy"
          />
        </div>
      )
    }
    <div class="flex flex-col justify-between flex-1">
      <div>
        <h2 class="font-cal text-gray-900 dark:text-white text-lg font-semibold tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200">
          {title}
        </h2>
        <p class="text-gray-600 dark:text-neutral-300 mt-1 text-sm leading-relaxed">
          {description}
        </p>
      </div>

      <div class="mt-4 flex flex-wrap gap-1.5">
        {
          tags.map((tag) => (
            <a
              href={`/projects?tech=${encodeURIComponent(tag)}`}
              data-tag-btn={tag}
              class="text-xs px-2.5 py-0.5 bg-neutral-100/80 dark:bg-neutral-800/60 backdrop-blur-xs border border-neutral-200/60 dark:border-neutral-700/60 text-neutral-700 dark:text-neutral-200 rounded-md font-medium hover:border-blue-400 dark:hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 hover:scale-105 transition-all duration-150 cursor-pointer text-left inline-block"
            >
              {tag}
            </a>
          ))
        }
      </div>

      <div class="flex gap-2 justify-end text-xs mt-3 flex-wrap">
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg border border-blue-500/50 dark:border-blue-400/40 bg-blue-50/50 dark:bg-blue-950/40 backdrop-blur-md text-blue-600 dark:text-blue-400 hover:bg-blue-500 hover:text-white dark:hover:bg-blue-500 dark:hover:text-white hover:-translate-y-0.5 hover:shadow-sm hover:border-blue-400 active:scale-95 active:translate-y-0 transition-all duration-200 ease-out font-medium shadow-2xs"
            >
              Live ↗
            </a>
          )
        }
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg border border-neutral-300/80 dark:border-neutral-700/70 bg-neutral-100/60 dark:bg-neutral-800/50 backdrop-blur-md text-neutral-700 dark:text-neutral-300 hover:bg-neutral-800 hover:text-white dark:hover:bg-neutral-200 dark:hover:text-neutral-900 hover:-translate-y-0.5 hover:shadow-sm hover:border-neutral-400 active:scale-95 active:translate-y-0 transition-all duration-200 ease-out font-medium shadow-2xs"
            >
              Source ↗
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
