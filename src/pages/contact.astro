---
import Layout from "@/layouts/Layout.astro";
import { Send } from "@lucide/astro";
---

<Layout
  title="Contact | Kavyadeep Dev"
  description="Get in touch with Kavyadeep Dev"
>
  <section
    class="flex flex-col justify-start md:justify-center min-h-full w-full max-w-[40rem] pt-8 md:pt-[8rem] pb-16 gap-6 md:gap-8"
  >
    <h2 class="font-cal text-gray-700 dark:text-white text-3xl sm:text-4xl">
      Message ✉️
    </h2>
    <form action="" class="flex flex-col gap-4 w-full">
      <div class="w-full flex flex-col sm:flex-row gap-4">
        <input
          type="text"
          placeholder="Name"
          class="bg-gray-100 dark:bg-neutral-800 border border-transparent dark:border-neutral-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-neutral-500 px-4 py-2 rounded-xl flex-1 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-neutral-600 transition-colors"
        />
        <input
          type="email"
          placeholder="Email"
          class="bg-gray-100 dark:bg-neutral-800 border border-transparent dark:border-neutral-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-neutral-500 px-4 py-2 rounded-xl flex-1 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-neutral-600 transition-colors"
        />
      </div>
      <textarea
        placeholder="Message"
        class="bg-gray-100 dark:bg-neutral-800 border border-transparent dark:border-neutral-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-neutral-500 px-4 py-2 rounded-xl h-48 md:h-[20rem] focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-neutral-600 text-sm resize-none transition-colors"
      ></textarea>
      <button
        type="submit"
        class="bg-blue-500 text-white py-2 rounded-xl font-bold flex justify-center items-center hover:cursor-pointer hover:bg-blue-600 dark:hover:bg-blue-400 transition shadow-xs"
      >
        <Send size={18} class="mt-0.5 mr-1" />
        Send
      </button>
    </form>
  </section>
</Layout>
